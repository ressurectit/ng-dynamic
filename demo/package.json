{
    "name": "ng-universal-demo",
    "version": "1.0.0",
    "description": "Angular sample application",
    "type": "module",
    "scripts": {
        "build": "ng build",
        "build:min": "ng build -c production",
        "build:worker": "webpack",
        "prebuild": "npm run version:build && npm run config:build && npm run copy:monaco",
        "prebuild:min": "npm run clean && npm run prebuild",
        "clean": "rimraf wwwroot config/configOverride.js config/configServerOverride.js config/configBrowserOverride.js version.json",
        "clean:deps": "rimraf package-lock.json node_modules .angular || echo 'node_modules removed'",
        "clean:all": "npm run clean && npm run clean:deps",
        "copy:monaco": "copyfiles -u 2 ../node_modules/monaco-editor/**/*.* node_modules",
        "version:build": "ngv -e \"node .utils/write.version.js\"",
        "config:build": "node .utils/generateConfig.js",
        "server": "node server.js",
        "lint": "eslint app/**/*.ts",
        "prestart": "npm run version:build && npm run config:build && npm run copy:monaco",
        "start": "concurrently \"npm run server -- --devPort\" \"ng serve\""
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "author": "kukjevov",
    "license": "MIT",
    "devDependencies": {
        "@anglr/datetime": "9.0.3",
        "@anglr/error-handling": "16.0.2",
        "@anglr/md-help": "11.0.0",
        "@anglr/notifications": "12.0.2",
        "@anglr/select": "17.0.1",
        "@anglr/server-stuff": "9.0.0",
        "@anglr/translate-extensions": "12.0.0",
        "@angular/build": "22.0.4",
        "@angular/cli": "22.0.4",
        "@angular/platform-server": "22.0.4",
        "@angular/service-worker": "22.0.4",
        "@angular/ssr": "22.0.4",
        "@css-styles/common": "2.0.1",
        "@css-styles/themes": "2.6.0",
        "@floating-ui/dom": "1.7.6",
        "@fortawesome/fontawesome-free": "7.2.0",
        "@ngx-translate/core": "17.0.0",
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "@types/node-localstorage": "1.3.3",
        "chalk": "4.1.2",
        "compression": "1.8.1",
        "concurrently": "10.0.3",
        "css-loader": "7.1.2",
        "dotenv": "17.4.2",
        "envsub": "4.1.0",
        "express": "5.2.1",
        "file-loader": "6.2.0",
        "http-proxy-middleware": "4.2.0",
        "mini-css-extract-plugin": "2.10.2",
        "node-localstorage": "3.0.5",
        "nodejs-connect-extensions": "3.0.0",
        "sourcemapped-stacktrace": "1.1.11",
        "style-loader": "4.0.0",
        "webpack": "5.108.4",
        "webpack-cli": "7.2.1",
        "yargs": "18.0.0"
    }
}
